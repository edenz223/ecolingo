{
  "name": "ecolingo",
  "version": "0.1.0",
  "description": "A desktop app for language learning with the shadowing method.",
  "productName": "EcoLingo",
  "author": "edenz223",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "yarn --cwd src-electron install --frozen-lockfile && quasar prepare --silent",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "yarn --cwd src-electron electron ../tests/app-smoke.cjs && yarn --cwd src-electron electron ../tests/voice-activity-smoke.cjs && yarn --cwd src-electron electron ../tests/learning-ui-smoke.cjs && yarn --cwd src-electron electron ../tests/visual-responsiveness-smoke.cjs",
    "dev": "quasar dev -m electron",
    "build": "quasar build --mode electron"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "howler": "^2.2.4",
    "quasar": "^2.35.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.22",
    "yarn": ">= 1.21.1"
  },
  "packageManager": "yarn@1.22.22"
}
